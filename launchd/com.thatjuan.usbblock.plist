<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thatjuan.usbblock</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/usbblock</string>
        <!-- Example: LG UltraFine display audio. Replace with your own IDs (see README). -->
        <string>043e:9a4b</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/usbblock.log</string>
</dict>
</plist>
